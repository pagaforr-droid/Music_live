{
  "installCommand": "unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR; npm install --no-fund --no-audit",
  "buildCommand": "unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR; npm run build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|cues/|assets/|.*\\.(?:wav|mp3|ogg|js|mjs|css|svg|png|jpg|jpeg|webp|ico|woff2|wasm|json|html)$).*)",
      "destination": "/index.html"
    }
  ]
}
